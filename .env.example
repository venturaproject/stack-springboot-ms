# Copy to .env and fill in. Never commit .env.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=boilerplate_spring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT_EXTERNAL=5439

DB_HOST=postgres
DB_PORT=5432
DB_NAME=boilerplate_spring
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate: openssl rand -base64 48
# The app refuses to start under SPRING_PROFILES_ACTIVE=prod if this is left as a default.
JWT_SECRET=

# ── Initial administrator (local development only) ────────────────────────────
# Dev profile only. For a new production database, inject a unique one-time password
# through a secret manager and remove it after the first account is created.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=admin123

# ── Cookies ───────────────────────────────────────────────────────────────────
# prod: COOKIE_SECURE=true, COOKIE_SAME_SITE=Strict
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8083

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME=Application
VITE_BACKEND_URL=http://localhost
VITE_PUBLIC_API_URL=
VITE_FULL_ACCESS_ROLES=ADMIN

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_PORT=8083

# ── Spring ────────────────────────────────────────────────────────────────────
# dev | prod  (prod activates application-prod.yml + ProductionConfigValidator)
SPRING_PROFILES_ACTIVE=dev

# ── Observability (optional) ──────────────────────────────────────────────────
# Raise to 0.1-1.0 and point at a collector to export spans.
TRACING_SAMPLE_PROBABILITY=0
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
# ecs | logstash | gelf  — leave blank for plain console logs
LOGGING_STRUCTURED_FORMAT_CONSOLE=
