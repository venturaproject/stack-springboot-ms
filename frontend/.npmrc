# Deps are installed as an explicit container step, so skip pnpm's pre-run lockfile check
# (it otherwise runs an implicit `install` before every `pnpm run` / `pnpm exec`).
# Build-script approvals live in pnpm-workspace.yaml (allowBuilds).
verify-deps-before-run=false
# Non-interactive containers can't answer the "purge node_modules?" prompt.
confirm-modules-purge=false
