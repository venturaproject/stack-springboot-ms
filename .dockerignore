# Build context is the repo root for app and optional-service images.
# Keep it small and deterministic — never ship a host node_modules / build dir into a stage.
.git
.github
.idea
.vscode
*.md

# Node / frontend
**/node_modules
frontend/.pnpm-store
frontend/dist
frontend/coverage
frontend/.env
frontend/.env.local

# Java / backend
backend/build
backend/.gradle
backend/bin
backend/out
backend/*.iml
**/build
**/.gradle
**/out
**/coverage
**/.pnpm-store
**/__pycache__
**/*.py[cod]

# Local env / overrides
.env
.env.local
compose.override.yml
