# Production frontend image: build the SPA, serve it static behind nginx, proxy /api.
# (The plain Dockerfile in this dir is the DEV edge — it proxies / to the Vite dev server.)
FROM node:22-alpine AS build

ENV CI=true
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
WORKDIR /app

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# .dockerignore keeps node_modules / .pnpm-store out of this copy so the frozen install stands.
COPY frontend/ .
# VITE_* build args are baked into the bundle at build time.
ARG VITE_PUBLIC_API_URL=""
ARG VITE_FULL_ACCESS_ROLES="ADMIN"
ARG VITE_APP_NAME="Application"
RUN pnpm run build

FROM nginx:1.27-alpine

ENV BACKEND_HOST=backend \
    BACKEND_PORT=8080

COPY infrastructure/nginx/templates/ /etc/nginx/templates/
COPY infrastructure/nginx/snippets/ /etc/nginx/snippets/
COPY --from=build /app/dist /usr/share/nginx/html

# Render the production template and validate its syntax at image-build time.
RUN BACKEND_HOST=127.0.0.1 BACKEND_PORT=8080 /docker-entrypoint.sh nginx -t

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1
