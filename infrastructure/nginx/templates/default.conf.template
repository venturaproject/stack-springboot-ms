# Production edge: serves the built SPA from disk, proxies the API to the backend.
# nginx:alpine runs envsubst over this at startup, substituting BACKEND_HOST / BACKEND_PORT
# (set in Dockerfile.prod, overridden at deploy time). $host, $uri, etc. are nginx's own.
#
# The backend host is resolved at startup — fine for compose and Kubernetes, where the
# Service DNS entry exists before the pod is Ready. For a setup where the backend may be
# absent at boot, switch to a `resolver` + variable `proxy_pass`.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_redirect off;
        client_max_body_size 10M;
    }

    location /media/ {
        alias /srv/media/;
        try_files $uri =404;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /swagger-ui  { proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; proxy_set_header Host $host; }
    location /v3/api-docs { proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}; proxy_set_header Host $host; }

    # Fingerprinted assets — cache hard.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/security-headers.conf;
        access_log off;
    }

    # SPA entry — never cache the shell.
    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
